{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Default Config",
            "description": "Default build using Ninja",
            "generator": "Ninja Multi-Config",
            "binaryDir": "${sourceDir}/.build/default",
            "cacheVariables": {
                "CMAKE_C_COMPILER": {
                    "value": "clang-20"
                },
                "CMAKE_CXX_COMPILER": {
                    "value": "clang++-20"
                },
                "TT_UMD_BUILD_TESTS": {
                    "value": "TRUE"
                },
                "TT_UMD_BUILD_SIMULATION": {
                    "value": "TRUE"
                },
                "CMAKE_EXPORT_COMPILE_COMMANDS": {
                    "value": "TRUE"
                }
            }
        },
        {
            "name": "clang-tidy",
            "inherits": "default",
            "description": "Run Clang Tidy checks during build",
            "binaryDir": "${sourceDir}/.build/clang-tidy",
            "cacheVariables": {
                "TT_UMD_ENABLE_CLANG_TIDY": {
                    "value": "OFF"
                },
                "CMAKE_CXX_CLANG_TIDY": {
                    "value": "clang-tidy-20;--config-file=${sourceDir}/.clang-tidy;--warnings-as-errors=*"
                },
                "CMAKE_EXPORT_COMPILE_COMMANDS": {
                    "value": "TRUE"
                },
                "CMAKE_DISABLE_PRECOMPILE_HEADERS": {
                    "value": "TRUE"
                }
            }
        },
        {
            "name": "clang-tidy-fix",
            "inherits": "clang-tidy",
            "description": "Run Clang Tidy and apply fixes",
            "binaryDir": "${sourceDir}/.build/clang-tidy-fix",
            "cacheVariables": {
                "CMAKE_CXX_CLANG_TIDY": {
                    "value": "clang-tidy-20;--config-file=${sourceDir}/.clang-tidy;--fix"
                }
            }
        },
        {
            "name": "clang-tidy-fix-parallel",
            "inherits": "clang-tidy",
            "description":
                "Run Clang Tidy in parallel and export fixes to YAML files (apply with clang-apply-replacements)",
            "binaryDir": "${sourceDir}/.build/clang-tidy-fix-parallel",
            "cacheVariables": {
                "CMAKE_CXX_CLANG_TIDY": {
                    "value":
                        "${sourceDir}/cmake/clang-tidy-export-fixes-wrapper.sh;${sourceDir}/.build/clang-tidy-fix-parallel/fixes;--config-file=${sourceDir}/.clang-tidy"
                }
            }
        },
        {
            "name": "windows-msvc",
            "displayName": "Windows MSVC",
            "description": "Windows build using Visual Studio 2022 (MSVC)",
            "generator": "Visual Studio 17 2022",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/.build/windows-msvc",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "TT_UMD_BUILD_STATIC": {
                    "value": "ON"
                },
                "TT_UMD_BUILD_TOOLS": {
                    "value": "OFF"
                },
                "TT_UMD_BUILD_TESTS": {
                    "value": "OFF"
                },
                "TT_UMD_BUILD_SIMULATION": {
                    "value": "OFF"
                },
                "TT_UMD_BUILD_PYTHON": {
                    "value": "OFF"
                },
                "TT_UMD_BUILD_EXAMPLES": {
                    "value": "OFF"
                },
                "TT_UMD_BUILD_JTAG": {
                    "value": "OFF"
                },
                "TT_UMD_ENABLE_CLANG_TIDY": {
                    "value": "OFF"
                },
                "CMAKE_COMPILE_WARNING_AS_ERROR": {
                    "value": "OFF"
                }
            }
        },
        {
            "name": "code-analysis",
            "inherits": "default",
            "description": "Run Clang Static Analyzer",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/.build/code-analysis",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": {
                    "value": "Debug"
                }
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default",
            "configuration": "Release"
        },
        {
            "name": "debug",
            "configurePreset": "default",
            "configuration": "Debug"
        },
        {
            "name": "windows-msvc",
            "configurePreset": "windows-msvc",
            "configuration": "Release"
        },
        {
            "name": "clang-tidy",
            "configurePreset": "clang-tidy",
            "configuration": "Release",
            "nativeToolOptions": [
                "-k0"
            ]
        },
        {
            "name": "clang-tidy-fix",
            "configurePreset": "clang-tidy-fix",
            "configuration": "Release",
            "nativeToolOptions": [
                "-j1",
                "-k0"
            ]
        },
        {
            "name": "clang-tidy-fix-parallel",
            "configurePreset": "clang-tidy-fix-parallel",
            "configuration": "Release",
            "nativeToolOptions": [
                "-k0"
            ]
        }
    ]
}
